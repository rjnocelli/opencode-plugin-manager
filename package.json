{
  "name": "opencode-plugin-manager",
  "version": "0.1.0",
  "description": "A CLI tool to install, uninstall, enable, disable, and manage opencode plugins",
  "type": "module",
  "bin": {
    "opm": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "manager",
    "cli"
  ],
  "license": "MIT"
}
